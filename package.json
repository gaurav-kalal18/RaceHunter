{
  "name": "racehunter",
  "version": "1.0.0",
  "description": "A concurrency benchmarking framework for evaluating race conditions in wallet transactions.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seed.ts",
    "attack": "tsx src/attack/raceHunter.ts",
    "test": "echo \"No tests yet\""
  },
  "keywords": [
    "typescript",
    "nodejs",
    "express",
    "postgresql",
    "prisma",
    "concurrency",
    "race-condition",
    "optimistic-locking",
    "benchmark"
  ],
  "author": "Gaurav Kalal",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "axios": "^1.19.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "prisma": "^6.16.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.2"
  }
}